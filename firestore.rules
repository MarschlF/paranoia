rules_version = '2';
// ─────────────────────────────────────────────────────────────
//  Paranøia – Firestore Sicherheitsregeln
//  Öffentlich lesbar:  settings, players, bosses, raids   (Roster & Progress)
//  Nur Mitglieder:     guides                       (Boss Guides)
//  Nur Offiziere:      raidDays, vods, comps        (Comp, Rotation, Loot, Logs, VoDs) – lesen UND schreiben
//  Guide gelesen:      guideReads – jeder nur sein eigenes Dokument, Offis alle
//  Umfragen:           polls lesen alle Raider; pollAnswers jeder nur die eigene, Offis alle
//  Bewerbungen:        applications – jeder darf anlegen (ohne Login), lesen/bearbeiten nur Offis
//  Schreiben:          nur Offiziere
//  "member" / "officer" kommen aus dem Discord-Login (Cloudflare Worker)
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember()  { return request.auth != null && request.auth.token.member == true; }
    function isOfficer() { return request.auth != null && request.auth.token.officer == true; }

    match /settings/{id} { allow read: if true;       allow write: if isOfficer(); }
    match /players/{id}  { allow read: if true;       allow write: if isOfficer(); }
    match /bosses/{id}   { allow read: if true;       allow write: if isOfficer(); }
    match /raids/{id}    { allow read: if true;       allow write: if isOfficer(); }

    match /raidDays/{id} { allow read: if isOfficer(); allow write: if isOfficer(); }
    match /vods/{id}     { allow read: if isOfficer(); allow write: if isOfficer(); }
    match /comps/{id}    { allow read: if isOfficer(); allow write: if isOfficer(); }
    match /guides/{id}   { allow read: if isMember(); allow write: if isOfficer(); }
    match /guideImages/{id} { allow read: if isMember(); allow write: if isOfficer(); }  // Bilder in den Boss Guides
    match /bossCovers/{id} { allow read: if true;       allow write: if isOfficer(); }   // Boss-Titelbilder (öffentlich: Startseite, Progress, Guides)
    match /addons/{id}   { allow read: if isMember(); allow write: if isOfficer(); }   // Nützliches: Addons, Profile, „Neu bei uns“

    // Guide-Lesebestätigung: jeder liest/schreibt nur sein eigenes Dokument, Offis alles.
    // Raider dürfen die Offi-Zuordnung (playerId) nicht ändern.
    // Online-Status: jeder schreibt nur sein eigenes Dokument, lesen nur Offis
    match /presence/{uid} {
      allow read: if isOfficer();
      allow write: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'at']);
    }

    match /guideReads/{uid} {
      allow read: if isOfficer() || (isMember() && request.auth.uid == uid);
      allow write: if isOfficer() || (isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'reads', 'playerId'])
        && request.resource.data.get('playerId', null) == (resource == null ? null : resource.data.get('playerId', null)));
    }

    // Bewerbungen: jeder darf EINE neue anlegen (ohne Login, Felder + Längen geprüft), lesen/bearbeiten nur Offis
    match /applications/{id} {
      allow read, update, delete: if isOfficer();
      allow create: if request.resource.data.keys().hasOnly(['char', 'realm', 'klasse', 'spec', 'offspec', 'discord', 'exp', 'why', 'logs', 'allDays', 'avail', 'other', 'consent', 'status', 'at'])
        && request.resource.data.status == 'neu' && request.resource.data.consent == true
        && request.resource.data.char is string && request.resource.data.char.size() >= 2 && request.resource.data.char.size() <= 24
        && request.resource.data.realm is string && request.resource.data.realm.size() >= 2 && request.resource.data.realm.size() <= 40
        && request.resource.data.klasse is string && request.resource.data.klasse.size() <= 12
        && request.resource.data.spec is string && request.resource.data.spec.size() <= 20
        && request.resource.data.discord is string && request.resource.data.discord.size() >= 2 && request.resource.data.discord.size() <= 40
        && request.resource.data.exp is string && request.resource.data.exp.size() <= 2000
        && request.resource.data.why is string && request.resource.data.why.size() <= 2000
        && request.resource.data.get('offspec', '').size() <= 60
        && request.resource.data.get('logs', '').size() <= 300
        && request.resource.data.get('avail', '').size() <= 300
        && request.resource.data.get('other', '').size() <= 1500
        && request.resource.data.at is string && request.resource.data.at.size() <= 30;
    }

    // Umfragen: alle Raider lesen, nur Offis anlegen/ändern
    match /polls/{id} { allow read: if isMember(); allow write: if isOfficer(); }

    // Antworten: Dokument-ID = <Umfrage>__<uid>. Jeder liest/schreibt nur seine eigene,
    // nur solange die Umfrage offen ist. Offis lesen alle (Auswertung) und dürfen löschen.
    match /pollAnswers/{id} {
      allow read: if isOfficer() || (isMember() && id.split('__')[1] == request.auth.uid);
      allow create, update: if isMember()
        && id == request.resource.data.pollId + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['pollId', 'uid', 'name', 'answers', 'at'])
        && get(/databases/$(database)/documents/polls/$(request.resource.data.pollId)).data.open == true;
      allow delete: if isOfficer();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
